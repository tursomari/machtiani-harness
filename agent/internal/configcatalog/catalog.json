{
  "schema_version": 1,
  "providers": [
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "description": "DeepSeek's OpenAI-compatible chat API.",
      "protocol": "openai-chat",
      "base_url": "https://api.deepseek.com",
      "endpoint": "/chat/completions",
      "api_key_env": "DEEPSEEK_API_KEY",
      "documentation_url": "https://api-docs.deepseek.com/",
      "default_model": "deepseek-v4-flash",
      "models": [
        {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "alias": "deepseek",
          "description": "Fast general-purpose DeepSeek V4 model.",
          "reasoning": [],
          "cache_default": "disabled"
        },
        {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "alias": "deepseek-pro",
          "description": "Higher-capability DeepSeek V4 model.",
          "reasoning": [],
          "cache_default": "disabled"
        }
      ]
    },
    {
      "id": "openai",
      "name": "OpenAI",
      "description": "OpenAI's Chat Completions API.",
      "protocol": "openai-chat",
      "base_url": "https://api.openai.com/v1",
      "endpoint": "/chat/completions",
      "api_key_env": "OPENAI_API_KEY",
      "documentation_url": "https://developers.openai.com/api/docs/models",
      "default_model": "gpt-5.5",
      "models": [
        {
          "id": "gpt-5.5",
          "name": "GPT-5.5",
          "alias": "openai",
          "description": "OpenAI's flagship model for complex reasoning and coding.",
          "reasoning": ["none", "low", "medium", "high", "xhigh"],
          "cache_default": "inherit"
        },
        {
          "id": "gpt-5.4",
          "name": "GPT-5.4",
          "alias": "openai-5.4",
          "description": "Previous-generation flagship model.",
          "reasoning": ["none", "low", "medium", "high", "xhigh"],
          "cache_default": "inherit"
        },
        {
          "id": "gpt-5.4-mini",
          "name": "GPT-5.4 mini",
          "alias": "openai-mini",
          "description": "Lower-latency GPT-5.4 model.",
          "reasoning": ["none", "low", "medium", "high", "xhigh"],
          "cache_default": "inherit"
        }
      ]
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "description": "OpenAI-compatible access to OpenRouter's model catalogue.",
      "protocol": "openai-chat",
      "base_url": "https://openrouter.ai/api/v1",
      "endpoint": "/chat/completions",
      "api_key_env": "OPENROUTER_API_KEY",
      "documentation_url": "https://openrouter.ai/docs/quickstart",
      "default_model": "~openai/gpt-latest",
      "models": [
        {
          "id": "~openai/gpt-latest",
          "name": "Latest OpenAI flagship",
          "alias": "openrouter",
          "description": "OpenRouter alias that tracks the latest OpenAI flagship model.",
          "reasoning": [],
          "cache_default": "inherit"
        }
      ]
    }
  ]
}
