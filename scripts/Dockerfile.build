# Stage 1: builder
FROM golang:1.23-bookworm AS builder
ENV GOFLAGS=-buildvcs=auto

# Optional patch to apply for version B builds
ARG CHANGE_PATCH_B64

# Install build dependencies
RUN apt-get update && apt-get install -y ripgrep rsync git gcc && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy Go module files first for layer caching (dependency downloads are cached
# as long as go.mod and go.sum don't change)
COPY --link agent/go.mod agent/go.sum ./
RUN go mod download

# Copy the full agent source tree
COPY --link agent/ ./agent/

# Copy the install script
COPY --link scripts/ ./scripts/

# Copy the .machtiani configuration
COPY --link .machtiani/ ./.machtiani/

# Copy .git so git apply and install.sh ldflag embedding (git_short_commit, git_dirty_flag) can run
COPY --link .git/ ./.git/

# Optionally apply a change patch for version B builds
RUN if [ -n "${CHANGE_PATCH_B64}" ]; then \
      echo "${CHANGE_PATCH_B64}" | base64 -d > /tmp/change.patch && \
      # Extract the list of files the patch touches and revert them to HEAD~1 \
      # so the patch applies cleanly on top of the base state, not HEAD. \
      files=$(grep -E "^diff --git a/" /tmp/change.patch | sed -E "s|^diff --git a/||; s| b/.*||" | sort -u) && \
      echo "Reverting to HEAD~1 for patched paths:" && echo "$files" && \
      for f in $files; do git --git-dir=/build/.git --work-tree=/build checkout HEAD~1 -- "/build/$f" || true; done && \
      git apply /tmp/change.patch && \
      git -c user.email=builder@local -c user.name=builder commit -am "treatment patch"; \
    fi

# Build all binaries (mct-agent, mct, file-discovery, snippet-discovery, shell-agent) into /build/bin
RUN PREFIX=/build ./scripts/install.sh --install-peripherals

# Stage 2: runtime
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y ripgrep rsync bash && rm -rf /var/lib/apt/lists/*

# Copy built binaries from the builder stage
COPY --from=builder /build/bin/ /usr/local/bin/
COPY --link peripherals/mct-forge /usr/local/bin/mct-forge

# Copy the Machtiani configuration
COPY --from=builder /build/.machtiani/ /workspace/.machtiani/
COPY --link --from=builder /build/agent/ /workspace/agent/

# Point binaries at the config
ENV MACHTIANI_CONFIG=/workspace/.machtiani/config.toml

ENV REPO_ROOT=/workspace

WORKDIR /workspace

ENTRYPOINT ["bash"]
