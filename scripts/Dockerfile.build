# Stage 1: builder
FROM golang:1.23-bookworm AS builder
ENV GOFLAGS=-buildvcs=auto

# Optional patch to apply for version B builds
ARG CHANGE_PATCH_B64
# Optional base commit to revert patched files to before applying the patch
# (defaults to HEAD~1 when not provided, preserving prior behavior)
ARG CHANGE_PATCH_BASE

# Install build dependencies
RUN apt-get update && apt-get install -y ripgrep rsync git gcc && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy Go module files first for layer caching (dependency downloads are cached
# as long as go.mod and go.sum don't change)
COPY --link agent/go.mod agent/go.sum ./
RUN go mod download

# Copy the full agent source tree
COPY --link agent/ ./agent/

# Copy build and test scripts
COPY --link scripts/ ./scripts/

# Copy the .machtiani configuration
COPY --link .machtiani/ ./.machtiani/

# Copy .git so treatment patches can be committed and runtime checks see a coherent revision
COPY --link .git/ ./.git/

# Optionally apply a change patch for version B builds
RUN if [ -n "${CHANGE_PATCH_B64}" ]; then \
      echo "${CHANGE_PATCH_B64}" | base64 -d > /tmp/change.patch && \
      # Remove all submodule gitlinks (their .git/modules/... entries are \
      # broken in the build context because .git/modules/ is excluded by \
      # .dockerignore). This prevents gits path resolution from landing on \
      # them and breaking checkout. \
      find . -name .git -type f -o -name .git -type l 2>/dev/null | xargs -r rm -f && \
      # Revert patched files to HEAD~1 so the patch applies cleanly. \
      files=$(grep -E "^diff --git a/" /tmp/change.patch | sed -E "s|^diff --git a/||; s| b/.*||" | sort -u) && \
      for f in $files; do git -C /build checkout "${CHANGE_PATCH_BASE:-HEAD~1}" -- "$f" 2>/dev/null || rm -f "/build/$f"; done && \
      git apply /tmp/change.patch && \
      # Commit the patched tree so the embedded commit hash matches HEAD.
      # The build embeds the committed tree state into the binary.
      # check_bin at runtime compares the embedded commit against HEAD, so
      # without this commit the embedded commit (old HEAD) would not match
      # the runtime repo HEAD (same old HEAD but with a dirty tree), and
      # check_bin hard-exits on "binary clean vs repo dirty" or
      # "binary dirty vs repo clean" mismatches. The commit normalizes
      # both commit and dirty state to "clean at the new HEAD".
      git -c user.email=builder@local -c user.name=builder commit -am "treatment patch"; \
    fi

# Build internal benchmark/development binaries directly. User installation is
# Nix-managed and does not use this image.
RUN mkdir -p /build/bin && cd agent && \
    go build -buildvcs=false -o /build/bin/machtiani ./cmd/machtiani && \
    go build -buildvcs=false -o /build/bin/meta-orchestrator ./cmd/meta-orchestrator && \
    go build -buildvcs=false -o /build/bin/file-discovery ./internal/file-discovery/cmd/file-discovery && \
    go build -buildvcs=false -o /build/bin/snippet-discovery ./internal/snippet-discovery/cmd/snippet-discovery && \
    go build -buildvcs=false -o /build/bin/shell-agent ./internal/shell-agent/cmd/shell-agent

# Stage 2: runtime
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y ripgrep rsync bash python3 git && rm -rf /var/lib/apt/lists/*
# Copy the Go toolchain from the builder stage (golang:1.23-bookworm) so
# tests that shell out to `go build` (e.g. the snippet-discovery-tight-
# readme test in agent/tests/run-live.sh) work in the runtime container.
# Using the same Go version as the builder guarantees the runtime
# `go` matches what built the binaries.
COPY --from=builder /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH

# Copy built binaries from the builder stage
COPY --from=builder /build/bin/ /usr/local/bin/
COPY --link peripherals/mct-forge /usr/local/bin/mct-forge

# Copy the Machtiani configuration
COPY --from=builder /build/.machtiani/ /workspace/.machtiani/
COPY --link --from=builder /build/agent/ /workspace/agent/

# Point binaries at the config
ENV MACHTIANI_CONFIG=/workspace/.machtiani/config.toml

ENV REPO_ROOT=/workspace

WORKDIR /workspace

RUN git config --global --add safe.directory /workspace && \
    git config --global --add safe.directory /workspace/.machtiani/artifacts/readme && \
    git config --global user.email "ab@local" && \
    git config --global user.name "ab" && \
    git init -b main && \
    git add -A && \
    git commit -m "initial" --allow-empty && \
    HEAD_HASH=$(git rev-parse HEAD) && \
    if [ -d /workspace/.machtiani/artifacts/readme/.git ]; then \
      git -C /workspace/.machtiani/artifacts/readme config user.email "ab@local" && \
      git -C /workspace/.machtiani/artifacts/readme config user.name "ab" && \
      git -C /workspace/.machtiani/artifacts/readme tag -f "oid-${HEAD_HASH}" HEAD; \
    fi

ENTRYPOINT ["/bin/sh"]
