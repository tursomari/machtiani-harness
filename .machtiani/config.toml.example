# Example Machtiani configuration excerpt showing prompt customization.
# Copy fields into your real .machtiani/config.toml and adjust as needed.
# Template references are relative to the directory containing this config (typically .machtiani/).

[prompts.planner]
system_template = { file = "templates/planner/system_template.tpl" }
instance_template = { file = "templates/planner/instance_template.tpl" }
timeout_template = { file = "templates/planner/timeout_template.tpl" }
format_error_template = { file = "templates/planner/format_error_template.tpl" }
plan_prompt = { file = "templates/planner/plan_prompt.tpl" }
plan_patch_rules = { file = "templates/planner/plan_patch_rules.tpl" }
plan_patch_enabled_intro = { file = "templates/planner/plan_patch_enabled_intro.tpl" }
plan_patch_disabled_intro = { file = "templates/planner/plan_patch_disabled_intro.tpl" }
finalize_prompt = { file = "templates/planner/finalize_prompt.tpl" }

[prompts.shell-agent]
system_template = { file = "templates/shell-agent/system_template.tpl" }
instance_template = { file = "templates/shell-agent/instance_template.tpl" }
timeout_template = { file = "templates/shell-agent/timeout_template.tpl" }
format_error_template = { file = "templates/shell-agent/format_error_template.tpl" }

[prompts.file_discovery]
system_prompt_template = { file = "templates/file-discovery/system_prompt_template.tpl" }

[prompts.mct]
shell_agent_context_prefix = { file = "templates/mct/shell_agent_context_prefix.tpl" }
header_user_template = { file = "templates/mct/header_user_template.tpl" }
header_existing_template = { file = "templates/mct/header_existing_template.tpl" }
