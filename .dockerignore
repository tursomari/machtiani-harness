# Machtiani runtime state - large session artifacts and caches
/.machtiani/sessions/
/.machtiani/tmp/
/.machtiani/issues/
# Allow the internal readme repo at .machtiani/artifacts/readme/ since
# machtiani run preflight requires a git tag in it for the current HEAD.
# Other artifacts/ contents (e.g. generated reports) remain excluded by
# the broad /artifacts/ pattern.
/.machtiani/artifacts/*
!/.machtiani/artifacts/readme/
!/.machtiani/artifacts/readme/**

# Git internals - submodule data, lost-found objects, and worktree metadata (multi-GB)
/.git/modules/
/.git/lost-found/
/.git/worktrees/

# Third-party submodules

# Plan and notes markdown files at the repository root
/docker-ab-testing-action-plan*.md
/*.md

# Stray test output logs at the repository root
/stdout.log
/stderr.log
